# ============================================================================
#  Jordan World — .gitignore
#  Built on the official Unity .gitignore + project-specific additions.
# ============================================================================

# ----- Unity Editor-generated folders (never commit) -----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# Editor crash dumps, trace logs
[Mm]emoryCaptures/
[Rr]ecordings/
sysinfo.txt
*.pidb
*.suo
*.user
*.unityproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.booproj
*.unitypackage
*.aab
*.apk

# ----- Unity autogenerated solution/project files -----
# Rider / Visual Studio / VS Code regenerate these from the asmdefs.
ExportedObj/
.consulo/
*.csproj
*.pidb.meta
*.pdb.meta
*.mdb.meta
*.unityproj.meta
*.sln
*.sln.meta
*.suo
*.suo.meta
*.VC.db.meta
*.VC.opendb.meta
*.vsconfig
*.booproj.meta

# ----- Addressables / Asset bundles -----
# Keep Addressables group settings under source control; exclude their
# generated bin and content state.
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ----- Burst compiled artifacts -----
# Burst debug info is produced per build and never shipped.
*_BurstDebugInformation_DoNotShip*/
*_BackUpThisFolder_ButDontShipItWithYourGame*/

# ----- IDE / OS cruft -----
.vs/
.idea/
.vscode/
*.suo
*.user
.DS_Store
Thumbs.db

# ----- Secrets / local overrides -----
# Nothing with real secrets should ever land in the repo; this is belt+braces.
.env
.env.*
!.env.example
*.local
*.secret
secrets/
UserSettings/local-*.json

# ----- Node (if any tooling lives alongside) -----
node_modules/

# ----- Pipeline data (Phase 2+) -----
# Baked tiles / intermediate GIS downloads do not go in the repo; the
# source data pulls and bake script live in /pipeline, outputs feed a CDN
# or on-device cache. Keep this list defensive.
pipeline/data/
pipeline/.cache/
pipeline/*.tif
pipeline/*.laz
pipeline/*.pbf
pipeline/*.osm.pbf

# ----- Scratch / per-user tweaks -----
scratch/
*.local.json
